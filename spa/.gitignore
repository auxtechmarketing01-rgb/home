# The root .gitignore anchors its Node rules with a leading slash (`/node_modules`,
# `/public/build`), so none of them reach into this directory. Without this file
# the SPA's dependencies and build output are tracked -- which is how ~19.6k
# node_modules files ended up in the index once.
node_modules/
dist/
dist-ssr/

# Vite writes a dep-optimisation and test cache under node_modules; listed
# separately so it stays ignored even if node_modules is ever vendored on purpose.
node_modules/.vite/

# Generated by the PWA plugin at build time, alongside dist/.
dev-dist/

# Local browser captures from verification runs; useful to keep on disk, never in git.
.screenshots/

*.local
*.tsbuildinfo

.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Leave both blank for local development: the client falls back to same-origin
# relative URLs, and vite.config.ts proxies /api and /sanctum to the Laravel
# server on 127.0.0.1:8000. No CORS, no cross-origin cookie rules.
#
# For a deployed SPA talking to a separately hosted API, set the absolute URL
# here and make sure the backend's FRONTEND_URL and SANCTUM_STATEFUL_DOMAINS
# include this app's origin.
VITE_BACKEND_URL=
VITE_API_BASE_URL=

# Where the dev proxy forwards /api, /sanctum and /storage. Defaults to
# http://127.0.0.1:8000. Override it if that port is taken, or shadowed by
# something that accepts the connection without answering.
VITE_DEV_API_PROXY=

# Public by design. The Pusher *secret* is a server credential and must never
# appear in a VITE_-prefixed variable, because everything with that prefix is
# compiled into the shipped bundle.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=

# The VAPID public key, matching VAPID_PUBLIC_KEY in the Laravel .env.
VITE_VAPID_PUBLIC_KEY=
